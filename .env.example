# ============================================================
# ft_transcendence — .env.example
# Nota: No subas nunca un .env real con secretos al repo.
# Basado en el docker-compose actual del proyecto.
# ============================================================


# =========================
# Entorno
# =========================
# local | prod
ENV=local


# =========================a
# Backend (Go / Gin)
# =========================
# Puerto expuesto en tu máquina
BACKEND_PORT=8080

# Host/puerto interno del contenedor
GO_SERVICE_HOST=0.0.0.0
GO_SERVICE_PORT=8080

# Comentadas porque el backend actual no las usa
# GO_SERVICE_NAME=
# GO_ENV=


# =========================
# Frontend
# =========================
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8080/api/v1

# Comentadas porque el docker-compose actual no las usa
# REACT_APP_ENV=
# REACT_APP_API_BASE_URL=
# REACT_APP_WS_BASE_URL=


# =========================
# Base de datos (Backend) - (Contenedor Postgres)
# =========================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=transcendence
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
# Para modo prod B_SSLMODE no puede ser disable
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Madrid


# =========================
# PgAdmin
# =========================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123


# =========================
# Vault (docker-compose actual no lo usa)
# =========================
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_API_ADDR=        # BORRAR: duplicada conceptualmente con VAULT_ADDR
# VAULT_DEV_ROOT_TOKEN_ID=
# VAULT_LOG_LEVEL=


# =========================
# JWT / Auth 
# =========================
JWT_SECRET=uwu-super-mega-secret-for-jwt-auth
# 86400s = 24h
JWT_EXPIRATION=86400
# para testeo 60s o puedes poner lo que queiras
# JWT_EXPIRATION=60

# =========================
# CORS allowed origins
# =========================
# Formato: lista separada por comas con las URLs permitidas
# Obligatorio en entorno "prod", en desarrollo si lo dejas vacio se vincula automáticamente con localhost:3000
GO_ALLOWED_URLS=

# =========================
# 2FA, falta implementar con Redis
# =========================
# Para la cesion de Token temporal de 2FA
ISSUER_2FA=Tuentifour
EXPIRATION_2FA=300 # 5 minutos


# =========================
# Nginx / Reverse Proxy (no existe servicio en compose actual)
# =========================
# DOMAIN=
# PROJECT_NAME=
# BACKEND_INTERNAL_URL=
# FRONTEND_INTERNAL_URL=
# NGINX_HOST=
# NGINX_HTTP_PORT=
# NGINX_HTTPS_PORT=
# SSL_CERT_PATH=
# SSL_KEY_PATH=


# =========================
# OAuth 42 (no implementado aún en compose actual)
# =========================
# OAUTH42_CLIENT_ID=
# OAUTH42_CLIENT_SECRET=
# OAUTH42_REDIRECT_URI=
# OAUTH42_AUTHORIZE_URL=
# OAUTH42_TOKEN_URL=
# OAUTH42_ME_URL=
# OAUTH42_SCOPE=
# OAUTH_STATE_SECRET=
# OAUTH_HTTP_TIMEOUT_MS=


# =========================
# ==REDIS==
# =========================
REDIS_HOST=CHANGE_ME
REDIS_PORT=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME


# =========================
# Elastic Stack (Elasticsearch, Kibana, Logstash)
# =========================
ELASTIC_USER=elastic
# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=changeme

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=changeme

# Version of Elastic products
STACK_VERSION=8.7.1

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200

# Port to expose Kibana to the host
KIBANA_PORT=5601

# Increase or decrease based on the available host memory (in bytes)
ES_MEM_LIMIT=1073741824
KB_MEM_LIMIT=1073741824
LS_MEM_LIMIT=1073741824
