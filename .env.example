# ============================================================
# ft_transcendence — .env.example
# Nota: No subas nunca un .env real con secretos al repo.
# Basado en el docker-compose actual del proyecto.
# ============================================================


# =========================
# Entorno
# =========================
# local | prod
ENV=local


# =========================a
# Backend (Go / Gin)
# =========================
# Puerto expuesto en tu máquina
BACKEND_PORT=8080

# Host/puerto interno del contenedor
GO_SERVICE_HOST=0.0.0.0
GO_SERVICE_PORT=8080

# Comentadas porque el backend actual no las usa
# GO_SERVICE_NAME=
# GO_ENV=

GO_ALLOWED_URLS=http://localhost:3000


# =========================
# Frontend
# =========================
FRONTEND_PORT=3000

# Comentadas porque el docker-compose actual no las usa
# REACT_APP_ENV=
# REACT_APP_API_BASE_URL=
# REACT_APP_WS_BASE_URL=


# =========================
# Base de datos (Backend) - (Contenedor Postgres)
# =========================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=transcendence
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
# Para modo prod B_SSLMODE no puede ser disable
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Madrid


# ============================================================
# BORRAR — Variables duplicadas de PostgreSQL
# ============================================================
# Estas variables están duplicadas respecto a DB_*.
# Mantener ambas puede provocar desincronización entre el backend
# y el contenedor de Postgres.

# POSTGRES_DB=transcendence
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_PORT=5432
# POSTGRES_HOST=


# =========================
# PgAdmin
# =========================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123


# =========================
# Vault (docker-compose actual no lo usa)
# =========================
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_API_ADDR=        # BORRAR: duplicada conceptualmente con VAULT_ADDR
# VAULT_DEV_ROOT_TOKEN_ID=
# VAULT_LOG_LEVEL=


# =========================
# JWT / Auth 
# =========================
JWT_SECRET=uwu-super-mega-secret-for-jwt-auth
# 86400s = 24h
JWT_EXPIRATION=86400
# para testeo 60s o puedes poner lo que queiras
# JWT_EXPIRATION=60

# =========================
# CORS (no aparece en docker-compose actual)
# =========================
# CORS_ALLOWED_ORIGINS=


# =========================
# Nginx / Reverse Proxy (no existe servicio en compose actual)
# =========================
# DOMAIN=
# PROJECT_NAME=
# BACKEND_INTERNAL_URL=
# FRONTEND_INTERNAL_URL=
# NGINX_HOST=
# NGINX_HTTP_PORT=
# NGINX_HTTPS_PORT=
# SSL_CERT_PATH=
# SSL_KEY_PATH=


# =========================
# OAuth 42 (no implementado aún en compose actual)
# =========================
# OAUTH42_CLIENT_ID=
# OAUTH42_CLIENT_SECRET=
# OAUTH42_REDIRECT_URI=
# OAUTH42_AUTHORIZE_URL=
# OAUTH42_TOKEN_URL=
# OAUTH42_ME_URL=
# OAUTH42_SCOPE=
# OAUTH_STATE_SECRET=
# OAUTH_HTTP_TIMEOUT_MS=
