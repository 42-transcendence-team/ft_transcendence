{
  "id": null,
  "uid": "go-runtime",
  "title": "Go Runtime Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Goroutines",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "go_goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Process Threads",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "process_threads",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Process CPU %",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m]) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RSS Memory (MB)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Allocated Memory",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Heap Objects",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_objects",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stack Memory",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_stack_inuse_bytes",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Allocation Rate (bytes/s)",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(go_memstats_alloc_bytes_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Reserved",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_sys_bytes",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "GC Runs / Second",
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_count[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Time / Second",
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_sum[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}