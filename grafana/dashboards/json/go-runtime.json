{
  "id": null,
  "uid": "go-runtime",
  "title": "Go Runtime Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Memory (bytes)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap In Use",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Cycles",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_count[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Objects",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_heap_objects",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stack In Use",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "go_memstats_stack_inuse_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}