# =========================
# App
# =========================
APP_ENV=development
APP_URL=CHANGE_ME
FRONTEND_URL=CHANGE_ME

# Sesión / cookies (si aplica)
SESSION_SECRET=CHANGE_ME__long_random
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# =========================
# OAuth 2.0 - 42 (Authorization Code Flow)
# =========================
OAUTH42_CLIENT_ID=CHANGE_ME
OAUTH42_CLIENT_SECRET=CHANGE_ME
# Debe coincidir EXACTO con el redirect/callback registrado en la app de 42
OAUTH42_REDIRECT_URI=https://localhost:8443/api/auth/42/callback

# Endpoints 42 (normalmente no cambian, pero mejor declararlos)
OAUTH42_AUTHORIZE_URL=https://api.intra.42.fr/oauth/authorize
OAUTH42_TOKEN_URL=https://api.intra.42.fr/oauth/token
OAUTH42_ME_URL=https://api.intra.42.fr/v2/me

# Scopes (ejemplo típico)
OAUTH42_SCOPE=public

# Protección CSRF del flujo OAuth (state)
OAUTH_STATE_SECRET=CHANGE_ME__long_random

# Opcional: timeout/reintentos al hablar con el provider
OAUTH_HTTP_TIMEOUT_MS=5000
